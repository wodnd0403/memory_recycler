  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CityLoreTerminal3D
  terminalTitle: "\uBCD1\uC6D0 \uAE30\uB85D \uB2E8\uB9D0"
  terminalBody: "\uCD08\uAE30 \uAE30\uC5B5 \uC0AD\uC81C \uAE30\uC220\uC740 \uCE58\uB8CC
    \uC7A5\uBE44\uB85C \uC2B9\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098
    \uC2B9\uC778 \uBB38\uC11C\uC5D0\uB294 '\uACE0\uD1B5\uC758 \uC81C\uAC70'\uC640
    '\uC99D\uC5B8\uC758 \uC81C\uAC70'\uAC00 \uAC19\uC740 \uC808\uCC28\uB85C \uBB36\uC5EC
    \uC788\uC2B5\uB2C8\uB2E4."
  objectiveHint: "\uCE58\uB8CC \uB3D9\uC758\uC11C \uAE30\uC5B5\uC744 \uBCF5\uC6D0\uD558\uBA74
    \uB3C4\uC2DC\uAC00 \uC65C \uCE68\uBB35\uD588\uB294\uC9C0 \uC54C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
