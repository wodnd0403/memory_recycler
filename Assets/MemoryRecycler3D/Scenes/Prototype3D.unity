  terminalBody: "\uCD08\uAE30 \uAE30\uC5B5 \uC0AD\uC81C \uAE30\uC220\uC740 \uCE58\uB8CC
    \uC7A5\uBE44\uB85C \uC2B9\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098
