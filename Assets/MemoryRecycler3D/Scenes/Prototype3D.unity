  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CityLoreTerminal3D
  terminalTitle: "\uBC29\uC1A1\uAD6D \uC911\uACC4 \uB2E8\uB9D0"
  terminalBody: "\uB9C8\uC9C0\uB9C9 \uC7AC\uB09C \uBC29\uC1A1\uC740 \uC1A1\uCD9C\uB418\uC9C0
    \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uB204\uAD70\uAC00 \uC2DC\uBBFC \uB300\uD53C
    \uBB38\uAD6C\uB97C \uC9C0\uC6B0\uACE0, \uB300\uC2E0 '\uC548\uC815\uC744 \uC704\uD574
    \uC7A0\uB4E4\uB77C'\uB294 \uBB38\uC7A5\uC744 \uB36E\uC5B4\uC37C\uC2B5\uB2C8\uB2E4."
  objectiveHint: "\uB179\uC2A8 \uBC29\uC1A1 \uB9C8\uC774\uD06C\uC640 \uC911\uC559
    \uC544\uCE74\uC774\uBE0C\uC758 \uC790\uC7A5\uAC00\uB97C \uBCF5\uC6D0\uD558\uBA74
    \uB9C8\uC9C0\uB9C9 \uBA85\uB839\uC758 \uC724\uACFD\uC774 \uB4DC\uB7EC\uB0A9\uB2C8\uB2E4."
