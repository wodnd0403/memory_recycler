  terminalBody: "\uC878\uC5C5 \uC568\uBC94\uC5D0\uC11C \uC9C0\uC6CC\uC9C4 \uC774\uB984\uC740
    \uD55C \uBA85\uC774 \uC544\uB2C8\uC5C8\uC2B5\uB2C8\uB2E4. \uD589\uC815 \uC11C\uBC84\uB294
