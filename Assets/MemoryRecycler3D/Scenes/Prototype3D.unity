  terminalBody: "\uC911\uC559 \uC544\uCE74\uC774\uBE0C\uB294 \uB2E8\uC21C \uC800\uC7A5\uC18C\uAC00
    \uC544\uB2D9\uB2C8\uB2E4. \uD68C\uC218\uC6D0\uC774 \uB0B4\uB9B0 \uC120\uD0DD\uC744
