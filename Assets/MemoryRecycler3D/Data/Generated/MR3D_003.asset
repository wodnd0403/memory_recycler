  id: MR3D_003
  memoryTitle: "\uCCAB \uBC88\uC9F8 \uCE58\uB8CC \uB3D9\uC758\uC11C"
  description: "\uAE30\uC5B5 \uC0AD\uC81C \uAE30\uC220\uC774 \uCC98\uC74C \uB3C4\uC785\uB41C
    \uBCD1\uC6D0 \uAE30\uB85D\uC785\uB2C8\uB2E4. \uBB38\uC11C\uC5D0\uB294 \uCE58\uB8CC\uB77C\uB294
    \uB9D0\uACFC \uD68C\uD53C\uB77C\uB294 \uB9D0\uC774 \uD568\uAED8 \uB0A8\uC544
    \uC788\uC2B5\uB2C8\uB2E4."
  emotion: 4
  corruptionLevel: 31
  sentencePieces:
  - "\uCC98\uC74C \uBAA9\uC801\uC740 \uC0C1\uCC98\uB97C \uB35C\uC5B4\uC8FC\uB294
    \uAC83\uC774\uC5C8\uB2E4"
  - "\uC0AC\uB78C\uB4E4\uC740 \uACE0\uD1B5\uC744 \uC904\uC774\uB294 \uBC95\uC744
    \uBC30\uC6E0\uB2E4"
  - "\uACE7 \uB204\uAD6C\uB3C4 \uACE0\uD1B5\uC758 \uC774\uC720\uB97C \uBB3B\uC9C0
    \uC54A\uC558\uB2E4"
  correctOrder:
  - "\uCC98\uC74C \uBAA9\uC801\uC740 \uC0C1\uCC98\uB97C \uB35C\uC5B4\uC8FC\uB294
    \uAC83\uC774\uC5C8\uB2E4"
  - "\uC0AC\uB78C\uB4E4\uC740 \uACE0\uD1B5\uC744 \uC904\uC774\uB294 \uBC95\uC744
    \uBC30\uC6E0\uB2E4"
  - "\uACE7 \uB204\uAD6C\uB3C4 \uACE0\uD1B5\uC758 \uC774\uC720\uB97C \uBB3B\uC9C0
    \uC54A\uC558\uB2E4"
  restoredText: "\uCE58\uB8CC\uB294 \uD544\uC694\uD588\uC9C0\uB9CC, \uB3C4\uC2DC\uB294
    \uC5B4\uB290 \uC21C\uAC04 \uC9C8\uBB38\uAE4C\uC9C0 \uC0AD\uC81C\uD558\uAE30 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4."
