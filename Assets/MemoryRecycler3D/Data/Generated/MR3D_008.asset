  memoryTitle: "\uC911\uC559 \uC544\uCE74\uC774\uBE0C\uC758 \uC790\uC7A5\uAC00"
  description: "\uC544\uCE74\uC774\uBE0C \uAE4A\uC740 \uACF3\uC5D0\uC11C \uBC18\uBCF5
    \uC7AC\uC0DD\uB418\uB294 \uC9E7\uC740 \uB178\uB798\uC785\uB2C8\uB2E4. \uB204\uAD70\uAC00
    \uB3C4\uC2DC \uC804\uCCB4\uB97C \uC7A0\uC7AC\uC6B0\uB824 \uD588\uB358 \uD754\uC801\uC785\uB2C8\uB2E4."
  emotion: 7
  corruptionLevel: 35
  locationName: "\uC911\uC559 \uC544\uCE74\uC774\uBE0C \uC2EC\uCE35\uBD80"
  archiveClue: "\uC790\uC7A5\uAC00\uB294 \uB3C4\uC2DC\uB97C \uB2EC\uB798\uAE30 \uC704\uD55C
    \uB178\uB798\uAC00 \uC544\uB2C8\uB77C, \uD310\uB2E8\uC744 \uBA48\uCD94\uAC8C
    \uD558\uB294 \uBA85\uB839\uC5B4\uC600\uC2B5\uB2C8\uB2E4."
  sentencePieces:
  - "\uC7A0\uB4E4\uBA74 \uC544\uD504\uC9C0 \uC54A\uB2E4"
  - "\uC78A\uC73C\uBA74 \uBBF8\uC6CC\uD558\uC9C0 \uC54A\uB294\uB2E4"
  - "\uAE68\uC5B4\uB098\uBA74 \uB2E4\uC2DC \uC120\uD0DD\uD574\uC57C \uD55C\uB2E4"
  correctOrder:
  - "\uC7A0\uB4E4\uBA74 \uC544\uD504\uC9C0 \uC54A\uB2E4"
  - "\uC78A\uC73C\uBA74 \uBBF8\uC6CC\uD558\uC9C0 \uC54A\uB294\uB2E4"
  - "\uAE68\uC5B4\uB098\uBA74 \uB2E4\uC2DC \uC120\uD0DD\uD574\uC57C \uD55C\uB2E4"
  restoredText: "\uD3C9\uC628\uC740 \uB54C\uB85C \uC9C4\uC2E4\uC744 \uB36E\uB294
